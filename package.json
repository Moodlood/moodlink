{
  "name": "moodlink",
  "version": "1.0.0",
  "description": "MoodLink — Full remote control hub between PC and Android",
  "main": "desktop/index.js",
  "bin": "desktop/index.js",
  "scripts": {
    "start": "node desktop/index.js",
    "build": "desktop\\server\\bin\\build_ui.bat && pkg . --targets node18-win-x64 --output dist/moodlink.exe"
  },
  "pkg": {
    "assets": [
      "desktop/renderer/**/*",
      "desktop/server/bin/ui.exe",
      "desktop/server/bin/Microsoft.Web.WebView2.Core.dll",
      "desktop/server/bin/Microsoft.Web.WebView2.WinForms.dll",
      "desktop/server/bin/WebView2Loader.dll",
      "desktop/server/bin/SoundVolumeView.exe",
      "desktop/server/bin/mouse.cs",
      "desktop/server/bin/bt-serial.cs",
      "desktop/server/bin/icon.ico"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "author": "MoodLink",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.0",
    "koffi": "^2.9.0",
    "multer": "^1.4.5-lts.1",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "systeminformation": "^5.23.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
